# PostgreSQL connection string used by Flask-SQLAlchemy.
DATABASE_URL=

# Local development defaults to threading; production uses gevent.
SOCKETIO_ASYNC_MODE=threading

# Exact browser origins, comma separated. Empty means no Origin is allowed.
# Example for local Vite: http://localhost:5173,http://127.0.0.1:5173
ALLOWED_ORIGINS=

# Generate separate, high-entropy values for these server-side secrets.
JWT_SECRET_KEY=
SECRET_KEY=
INVITE_CODE=

# External service credentials. Keep actual values only in a local .env file
# or in the deployment platform's secret store.
GEMINI_API_KEY=
FXRATES_API_KEY=
